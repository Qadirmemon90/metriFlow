# Node & Application Runtime
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# MongoDB Database (Replica set required for transactions)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/MetriFlowDev?retryWrites=true&w=majority

# Redis & BullMQ
REDIS_URL=redis://127.0.0.1:6379

# Session & Security
SESSION_SECRET=change_this_to_a_minimum_32_character_secret_key_in_production
SESSION_TTL_HOURS=12

# Object Storage (Local disk or S3-compatible)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/storage
# S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
# S3_REGION=ap-southeast-1
# S3_BUCKET=metriflow-private-storage
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Email Delivery (SMTP or Memory)
EMAIL_ADAPTER=console
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MetriFlow <no-reply@metriflow.pk>"

# Meta WhatsApp Cloud API
META_APP_ID=
META_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dev_whatsapp_verify_token_replace_in_prod
WHATSAPP_API_VERSION=v21.0

# Google Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Platform Super Admin Seed
SUPER_ADMIN_EMAIL=admin@metriflow.pk
SUPER_ADMIN_PASSWORD=AdminPass123!
SUPER_ADMIN_NAME="MetriFlow SuperAdmin"

# Billing Configuration
BILLING_MODE=manual
