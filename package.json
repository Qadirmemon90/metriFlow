{
  "name": "metriflow",
  "version": "1.0.0",
  "private": true,
  "description": "Production-oriented wholesale management SaaS for Pakistani wholesalers",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@metriflow/web",
    "dev:web": "npm run dev --workspace=@metriflow/web",
    "dev:api": "npm run dev --workspace=@metriflow/api",
    "dev:worker": "npm run dev --workspace=@metriflow/worker",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace=@metriflow/api",
    "seed": "npm run seed --workspace=@metriflow/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
